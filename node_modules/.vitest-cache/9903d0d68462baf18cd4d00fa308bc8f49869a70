t x = Math.max(8, Math.min(r.left + r.width / 2 - W / 2, window.innerWidth - W - 8));\n    setPos(r.top > 210 ? { left: x, top: r.top - 8, transform: 'translateY(-100%)' } : { left: x, top: r.bottom + 8 });\n  };\n  const hide = () => setPos(null);\n  return (\n    <span className=\"stip-host\" ref={hostRef} onMouseEnter={show} onMouseLeave={hide}>\n      {children}\n      {pos && createPortal(\n        <div className=\"stip\" style={pos} role=\"tooltip\">{build()}</div>,\n        document.body,\n      )}\n    </span>\n  );\n}\n\nfunction scoreTone(v) {\n  return v >= 80 ? 'success' : v >= 60 ? 'warning' : 'danger';\n}\n\nfunction TierTip({ s }) {\n  const { t } = useT();\n  const score = Math.round(s.score || 0);\n  const tone = scoreTone(score);\n  return (\n    <>\n      <div className=\"stip-head\">\n        <span className={'asm2-grade g-' + s.grade}>{s.grade}</span>\n        <span className=\"stip-title\">{t('zapret.tierTipTitle', { grade: s.grade, score })}</span>\n      </div>\n      <div className={'stip-bar b-' + tone}><span style={{ width: Math.max(3, Math.min(100, score)) + '%' }} /></div>\n      <div className=\"stip-rows\">\n        {typeof s.availability === 'number' && (\n          <div className=\"stip-row\"><span>{t('zapret.tipAvail')}</span><b>{Math.round(s.availability)}%</b></div>\n        )}\n        {typeof s.key_resources === 'number' && s.key_resources >= 0 && (\n          <div className=\"stip-row\"><span>{t('zapret.tipKey')}</span><b>★ {Math.round(s.key_resources)}%</b></div>\n        )}\n        {((s.speed_mbps || 0) > 0 || (s.ping_ms || 0) > 0) && (\n          <div className=\"stip-row\"><span>{t('zapret.tipSpeed')}</span><b>{(s.speed_mbps || 0).toFixed(1)} {t('monitor.mbps')} · {Math.round(s.ping_ms || 0)}{t('common.ms')}</b></div>\n        )}\n        {s.weakest && <div className=\"stip-row\"><span>{t('zapret.tipWeakest')}</span><b>{t('zapret.weakestShort.' + s.weakest)}</b></div>}\n      </div>\n    </>\n  );\n}\n\nfunction GameTip({ s }) {\n  const { t } = useT();\n  const score = Math.round(s.game_score || 0);\n  const tone = scoreTone(score);\n  return (\n    <>\n      <div className=\"stip-head\">\n        <span className={'stip-grade c-' + tone}><Gamepad2 size={14} strokeWidth={2.2} /></span>\n        <span className=\"stip-title\">{t('zapret.tipGameTitle')}</span>\n        <span className={'stip-score c-' + tone}>{score}</span>\n      </div>\n      <div className={'stip-bar b-' + tone}><span style={{ width: Math.max(3, Math.min(100, score)) + '%' }} /></div>\n      {(s.game_ping_ms > 0 || (s.game_total || 0) > 0) && (\n        <div className=\"stip-rows\">\n          {s.game_ping_ms > 0 && (\n            <div className=\"stip-row\"><span>{t('zapret.tipGamePing')}</span><b>{s.game_ping_ms}{t('common.ms')}</b></div>\n          )}\n          {(s.game_total || 0) > 0 && (\n            <div className=\"stip-row\"><span>{t('zapret.tipGamePlatforms')}</span><b>{s.game_ok}/{s.game_total}</b></div>\n          )}\n          {(s.game_gf_tcp || s.game_gf_udp) && (\n            <div className=\"stip-row\"><span>{t('zapret.tipGamePorts')}</span><b>{s.game_gf_tcp && s.game_gf_udp && s.game_gf_tcp === s.game_gf_udp ? s.game_gf_tcp : `TCP ${s.game_gf_tcp || '—'} · UDP ${s.game_gf_udp || '—'}`}</b></div>\n          )}\n        </div>\n      )}\n      <div className={'stip-hint c-' + tone}>\n        {score >= 80 ? t('zapret.tipGameGood') : score >= 60 ? t('zapret.tipGameMid') : t('zapret.tipGameBad')}\n      </div>\n    </>\n  );\n}\n\nconst HIDE_MODE_KEY = 'zpui-strat-hide-mode';\nconst HIDE_TIERS_KEY = 'zpui-strat-tier-toggles';\nconst TOGGLE_KEYS = ['a', 'b', 'c', 'd', 'untested'];\n// Фильтр стратегий — тумблеры показа по тирам. Тир S виден всегда (тумблера\n// нет), тумблеры — для A, B, C, D и непроверенных. По умолчанию показаны\n// S (всегда), A и B.\nconst TIER_TOGGLES_DEFAULT = { a: true, b: true, c: false, d: false, untested: false };\n// Миграция прежнего режима-порога в набор тумблеров.\nconst HIDE_MODE_TO_TOGGLES = {\n  s: { a: false, b: false, c: false, d: false, untested: false },\n  a: { a: true, b: false, c: false, d: false, untested: false },\n  b: { a: true, b: true, c: false, d: false, untested: false },\n  c: { a: true, b: true, c: true, d: true, untested: false },\n  tested: { a: true, b: true, c: true, d: true, untested: false },\n  all: { a: true, b: true, c: true, d: true, untested: true },\n};\n\n// Валидный набор тумблеров: объект, где есть хотя бы один boolean-ключ из пяти.\nfunction validToggles(raw) {\n  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return null;\n  return TOGGLE_KEYS.some((k) => typeof raw[k] === 'boolean') ? raw : null;\n}\n\n// Разовая миграция из localStorage WebView2 (привязан к профилю и стирается\n// переустановкой): сперва набор тумблеров, затем легаси-режим-порог.\nfunction readLegacyToggles() {\n  try {\n    const saved = localStorage.getItem(HIDE_TIERS_KEY);\n    if (saved) {\n      const parsed = JSON.parse(saved);\n      if (validToggles(parsed)) return parsed;\n    }\n    const mode = localStorage.getItem(HIDE_MODE_KEY);\n    if (mode && HIDE_MODE_TO_TOGGLES[mode]) return HIDE_MODE_TO_TOGGLES[mode];\n  } catch {}\n  return null;\n}\n\nexport default function StrategiesTab({ status, zRun }) {\n  const showToast = useToast();\n  const { t } = useT();\n  // Keep-mounted вкладки: портал-«хром» (чип скрытых стратегий, контекстное\n  // меню) не должен висеть над другой активной вкладкой.\n  const pageVisible = usePageVisible();\n  const [strategies, setStrategies] = useState([]);\n  const [stratLoaded, setStratLoaded] = useState(false);\n  const [changing, setChanging] = useState(null);\n  const [testResults, setTestResults] = useState({});\n  // Источник истины — config.json (strat_tier_toggles): выбор переживает\n  // переустановку. До первого чтения конфига — дефолт; см. эффект ниже.\n  const [tierToggles, setTierToggles] = useState(TIER_TOGGLES_DEFAULT);\n  const [hideMenu, setShowHideMenu] = useState(false);\n  const [hideMenuRender, hideMenuClosing] = useDelayedUnmount(hideMenu, 200);\n  const hideMenuRef = useRef(null);\n  const [ctxMenu, setCtxMenu] = useState(null); // {x, y, filename}\n  const [singleTestFile, setSingleTestFile] = useState(null); // ПКМ-проверка: модалка\n  const [singleTestGame, setSingleTestGame] = useState(false); // ПКМ: игровой режим\n  const testingTimerRef = useRef(null);\n\n  // Первое чтение набора тумблеров: config.json → если поля ещё нет,\n  // разовая миграция из localStorage (там выбор и применяется, и сразу\n  // переносится в конфиг; дальше localStorage только читается легаси-путём).\n  // Чтение с ретраем: если GET упал (бэкенд ещё поднимается/сбой), миграция\n  // раньше не повторялась до рестарта приложения — до 3 попыток с паузой ~2с,\n  // alive гасит попытки после размонтирования.\n  useEffect(() => {\n    let alive = true;\n    let timer = null;\n    const attempt = (n) => {\n      api('GET', '/api/config').then((cfg) => {\n        if (!alive) return;\n        if (!cfg || cfg.error) {\n          if (n < 3) timer = setTimeout(() => attempt(n + 1), 2000);\n          return;\n        }\n        const saved = validToggles(cfg.strat_tier_toggles);\n        if (saved) {\n          setTierToggles({ ...TIER_TOGGLES_DEFAULT, ...saved });\n          return;\n        }\n        const legacy = readLegacyToggles();\n        if (legacy) {\n          const merged = { ...TIER_TOGGLES_DEFAULT, ...legacy };\n          setTierToggles(merged);\n          api('POST', '/api/config', { strat_tier_toggles: merged }).catch(() => {});\n        }\n      }).catch(() => {\n        if (!alive || n >= 3) return;\n        timer = setTimeout(() => attempt(n + 1), 2000);\n      });\n    };\n    attempt(1);\n    return () => { alive = false; if (timer) clearTimeout(timer); };\n  }, []);\n\n  const loadStrategies = useCallback(async () => {\n    const d = await api('GET', '/api/zapret/strategies');\n    if (d) setStrategies(d.strategies || []);\n    setStratLoaded(true);\n  }, []);\n\n  const loadTestResults = useCallback(async () => {\n    const d = await api('GET', '/api/zapret/auto-test-results');\n    if (d?.results) {\n      const map = {};\n      for (const r of d.results) {\n        if (r.strategy) {\n          // pct приходит из БД (availability_pct); fallback — ok/total.\n          const pct = r.pct ?? (r.total > 0 ? Math.round((r.ok / r.total) * 100) : 0);\n          map[r.strategy] = { ...r, pct };\n        }\n      }\n      setTestResults(map);\n    }\n  }, []);\n\n  // Мгновенное обновление одного результата (соло-тест) — без перезагрузки.\n  const mergeSingleResult = useCallback((res) => {\n    if (!res?.strategy) return;\n    // Игровой результат не трогает ресурсный тиер — только game-балл в БД.\n    if (res.game) return;\n    const pct = res.pct ?? 0;\n    setTestResults(prev => ({\n      ...prev,\n      [res.strategy]: { ...prev[res.strategy], strategy: res.strategy, pct, ok_count: res.ok_count, total: res.total },\n    }));\n  }, []);\n\n  useEffect(() => {\n    loadStrategies();\n    loadTestResults();\n  }, [loadStrategies, loadTestResults]);\n\n  // Живые данные: события бэкенда (смена стратегии, игровой фильтр, ipset,\n  // завершение подбора) + мягкий поллинг на случай пропущенных событий.\n  useEffect(() => {\n    const refresh = () => { loadStrategies(); loadTestResults(); };\n    const offs = [\n      subscribeEvent('zapret:strategies-changed', refresh),\n      subscribeEvent('strategy:changed', refresh),\n      subscribeEvent('autoselect:done', refresh),\n    ];\n    return () => offs.forEach((off) => off());\n  }, [loadStrategies, loadTestResults]);\n\n  usePolling(() => { loadStrategies(); loadTestResults(); }, 10000, [loadStrategies, loadTestResults]);\n\n  // Правый клик → SingleStrategyTestModal (свой polling + отмена).\n  // Событие strategy:single_test слушает только модалка — дублирующий\n  // обработчик здесь вызывал спам тостов.\n\n  const handleCtxMenu = useCallback((e, filename) => {\n    e.preventDefault();\n    e.stopPropagation();\n    // Координаты курсора: позиционирование/флип делает useLayoutEffect ниже.\n    setCtxMenu({ x: e.clientX, y: e.clientY, filename });\n  }, []);\n\n  // Меню рендерится порталом в body: fixed-предки со transform (например\n  // .stagger после анимации — transform сохраняется fill-mode'ом both и\n  // становится containing block для fixed) больше не сбивают координаты.\n  // Точка появления = курсор, у краёв окна меню флипается и клампится;\n  // transform-origin выставляется по флипу (анимация растёт от угла).\n  const [ctxPos, setCtxPos] = useState(null);\n  const ctxRef = useRef(null);\n  useLayoutEffect(() => {\n    if (!ctxMenu || !ctxRef.current) { setCtxPos(null); return; }\n    const b = ctxRef.current.getBoundingClientRect();\n    const vw = window.innerWidth;\n    const vh = window.innerHeight;\n    let x = ctxMenu.x;\n    let y = ctxMenu.y;\n    let ox = 'left';\n    let oy = 'top';\n    if (x + b.width + 8 > vw) { x = vw - b.width - 8; ox = 'right'; }\n    if (y + b.height + 8 > vh) { y = ctxMenu.y - b.height - 4; oy = 'bottom'; }\n    x = Math.max(8, Math.min(x, vw - b.width - 8));\n    y = Math.max(8, Math.min(y, vh - b.height - 8));\n    setCtxPos({ x: Math.round(x), y: Math.round(y), origin: `${oy} ${ox}` });\n  }, [ctxMenu]);\n\n  // Выход меню — анимированный: узел держится 180мс с .is-closing\n  // (данные последнего меню сохраняем, чтобы пункт не мигнул при закрытии).\n  const [ctxRender, ctxClosing] = useDelayedUnmount(!!ctxMenu, 180);\n  const ctxDataRef = useRef(null);\n  if (ctxMenu) ctxDataRef.current = ctxMenu;\n\n  const runSingleTest = useCallback((filename, game = false) => {\n    setCtxMenu(null);\n    // Идёт переключение стратегии — одиночный тест сейчас не запускаем\n    // (меню доступно и на залоченных карточках: просмотр/ПКМ всегда работают).\n    // Раньше гард молчал — клик выглядел как «не сработало» (репорт владельца\n    // о «двух нажатиях»); теперь явный тост.\n    if (changing !== null) {\n      showToast(t('zapret.stratTestBusy'), 'info');\n      return;\n    }\n    if (!zRun) {\n      showToast(t('zapret.stratLockedOff'), 'warning');\n      return;\n    }\n    setSingleTestGame(game);\n    setSingleTestFile(filename); // открывает отдельную модалку проверки\n  }, [zRun, changing, showToast, t]);\n\n  // Закрытие контекстного меню при клике ВНЕ его.\n  // mousedown на самой кнопке меню НЕ закрывает — иначе click не сработает\n  // (React размонтирует кнопку до события click).\n  useEffect(() => {\n    if (!ctxMenu) return;\n    const close = (e) => {\n      if (e.target.closest && e.target.closest('.strat-ctx-menu')) return;\n      setCtxMenu(null);\n    };\n    document.addEventListener('mousedown', close);\n    return () => document.removeEventListener('mousedown', close);\n  }, [ctxMenu]);\n\n  // Тир стратегии: грейд из оценок системы (StrategyScores); в результатах\n  // автотеста грейда нет — считаем по проценту теми же порогами, что GradeOf\n  // (дефолт 90/80/70/60; серверный набор перекрывает только в модалке подбора).\n  const gradeOfStrategy = useCallback((s) => {\n    if (s.grade) return s.grade;\n    const tr = testResults[s.filename];\n    if (tr && tr.pct) {\n      if (tr.pct >= 90) return 'S';\n      if (tr.pct >= 80) return 'A';\n      if (tr.pct >= 70) return 'B';\n      if (tr.pct >= 60) return 'C';\n      return 'D';\n    }\n    return '';\n  }, [testResults]);\n\n  // Сортировка: по баллу — чем выше балл, тем выше в списке; стратегии\n  // без балла (не тестировались) — в конце, по имени.\n  const sortedStrategies = useMemo(() => {\n    return [...strategies].sort((a, b) => {\n      const sa = a.score || 0;\n      const sb = b.score || 0;\n      if ((sa > 0) !== (sb > 0)) return sa > 0 ? -1 : 1;\n      if (sa !== sb) return sb - sa;\n      return cmpStrategiesNatural(a, b);\n    });\n  }, [strategies]);\n\n  // Фильтр по тумблерам тиров: S видна всегда, текущая стратегия видна всегда\n  // (её выбор должен быть заметен). Непроверенные (и без тира) — тумблер\n  // «непроверенные».\n  const filteredStrategies = useMemo(() => {\n    return sortedStrategies.filter(s => {\n      if (s.current) return true;\n      const g = gradeOfStrategy(s);\n      if (!g) return tierToggles.untested;\n      if (g === 'S') return true;\n      return tierToggles[g.toLowerCase()];\n    });\n  }, [sortedStrategies, tierToggles, gradeOfStrategy]);\n\n  const hiddenCount = sortedStrategies.length - filteredStrategies.length;\n\n  const setTierToggleSaved = (id, on) => {\n    setTierToggles(prev => {\n      const next = { ...prev, [id]: on };\n      // Прямой POST полным набором из 5 ключей (патч одного поля конфига);\n      // '/api/config' никуда не кэшируется — инвалидация не нужна.\n      api('POST', '/api/config', { strat_tier_toggles: next }).catch(() => {});\n      return next;\n    });\n  };\n\n  useEffect(() => {\n    if (!hideMenu) return;\n    const close = (e) => {\n      if (e.target.closest && e.target.closest('.strat-hide-menu')) return;\n      setShowHideMenu(false);\n    };\n    document.addEventListener('mousedown', close);\n    return () => document.removeEventListener('mousedown', close);\n  }, [hideMenu]);\n\n  // Контрол скрытия живёт в ряду подвкладок (справа) — рендерится порталом\n  // в слот, который ZapretPage оставляет в строке «Стратегии / Списки».\n  const [hideSlot, setHideSlot] = useState(null);\n  useEffect(() => {\n    setHideSlot(document.getElementById('strat-hide-slot'));\n  }, []);\n\n  const handleSet = async (fn) => {\n    setChanging(fn);\n    const ok = await apiCall(() => api('POST', '/api/zapret/set-strategy', { filename: fn }), t('zapret.strategyApplied'), showToast);\n    await loadStrategies();\n    setChanging(null);\n  };\n\n  // Стратегии заблокированы, пока запрет выключен (в т.ч. стартует/перезапускается)\n  // или идёт переключение стратегии.\n  const stratLocked = !zRun || changing !== null;\n\n  return (\n    <>\n      {hideSlot && pageVisible && createPortal(\n        <>\n          {hiddenCount > 0 && (\n            <span className=\"zp-strat-hidden mono\" data-tooltip={t('zapret.stratHiddenTip')} data-tooltip-pos=\"bottom\">\n              {t('zapret.stratHiddenCount', { n: hiddenCount })}\n            </span>\n          )}\n          <span className=\"strat-hide-wrap\" ref={hideMenuRef}>\n            <button\n              className={'zp-gear-btn' + (hideMenu ? ' open' : '')}\n              onClick={() => setShowHideMenu(!hideMenu)}\n              data-tooltip={t('zapret.stratHideMenu')}\n              data-tooltip-pos=\"bottom\"\n              aria-label={t('zapret.stratHideMenu')}\n            >\n              <Ellipsis size={14} />\n            </button>\n            {hideMenuRender && (\n              <div className={'zp-autoswitch-menu strat-hide-menu' + (hideMenuClosing ? ' is-closing' : '')} role=\"menu\">\n                <div className=\"zp-autoswitch-menu-header\">{t('zapret.stratHideMenu')}</div>\n                {[\n                  { id: 'a', label: t('zapret.stratTierA') },\n                  { id: 'b', label: t('zapret.stratTierB') },\n                  { id: 'c', label: t('zapret.stratTierC') },\n                  { id: 'd', label: t('zapret.stratTierD') },\n                  { id: 'untested', label: t('zapret.stratUntested') },\n                ].map(m => (\n                  <label\n                    key={m.id} role=\"menuitemcheckbox\" aria-checked={tierToggles[m.id]}\n                    className=\"strat-hide-opt\"\n                    onClick={e => e.preventDefault()}\n                  >\n                    {m.label}\n                    <Switch checked={!!tierToggles[m.id]} onChange={() => setTierToggleSaved(m.id, !tierToggles[m.id])} />\n                  </label>\n                ))}\n              </div>\n            )}\n          </span>\n        </>,\n        hideSlot\n      )}\n      {/* Тулбар рисуем только с содержимым: пустой контейнер давал лишний\n          промежуток под рядом подвкладок после переноса контрола скрытия */}\n      {!zRun && (\n        <div className=\"zp-strat-toolbar\">\n          <span className=\"strat-lock-hint\">{t('zapret.stratLockedOff')}</span>\n        </div>\n      )}\n\n      <div className=\"strat-grid\">\n        {!stratLoaded ? (\n          Array.from({ length: 8 }, (_, i) => (\n            <div key={i} className=\"strat-card-skel skeleton skeleton-pulse\"><div className=\"skeleton-line\" style={{ width: '64%' }} /></div>\n          ))\n        ) : filteredStrategies.map((s, ci) => {\n          return (\n            <button\n              key={s.filename}\n              style={{ '--ci': ci }}\n              className={'strat-card' + (s.current ? ' active' : '') + (stratLocked && !s.current ? ' locked' : '')}\n              onClick={() => !s.current && !stratLocked && handleSet(s.filename)}\n              onContextMenu={(e) => handleCtxMenu(e, s.filename)}\n              aria-disabled={stratLocked}\n            >\n              {s.grade && (\n                <StratTip build={() => <TierTip s={s} />}>\n                  <span className={'strat-card-tier t-' + s.grade}>\n                    {s.grade}\n                  </span>\n                </StratTip>\n              )}\n              <span className=\"strat-card-name\">{s.name}</span>\n              {(s.game_badge || (s.game_score || 0) > 0) && (\n                <StratTip build={() => <GameTip s={s} />}>\n                  <span\n                    className={'strat-card-game' + ((s.game_score || 0) >= 80 ? '' : (s.game_score || 0) >= 60 ? ' mid' : ' low')}\n                  >\n                    <Gamepad2 size={15} strokeWidth={2.2} />\n                  </span>\n                </StratTip>\n              )}\n              {changing === s.filename && <Spinner size={10} />}\n            </button>\n          );\n        })}\n        {stratLoaded && filteredStrategies.length === 0 && <div className=\"strat-empty\">{t('zapret.noStrategies')}</div>}\n      </div>\n\n      {ctxRender && ctxDataRef.current && pageVisible && createPortal(\n        <div\n          ref={ctxRef}\n          className={'strat-ctx-menu' + (ctxClosing ? ' is-closing' : '')}\n          style={ctxPos ? { left: ctxPos.x, top: ctxPos.y, transformOrigin: ctxPos.origin } : { left: -9999, top: -9999 }}\n          onMouseDown={e => e.stopPropagation()}\n        >\n          <button\n            className=\"strat-ctx-item\"\n            disabled={!zRun}\n            onMouseDown={e => e.stopPropagation()}\n            onClick={() => runSingleTest(ctxDataRef.current.filename)}\n          >\n            <RefreshCw size={12} strokeWidth={2.2} />\n            {t('zapret.testSingleStrategy')}\n          </button>\n          <button\n            className=\"strat-ctx-item\"\n            disabled={!zRun}\n            onMouseDown={e => e.stopPropagation()}\n            onClick={() => runSingleTest(ctxDataRef.current.filename, true)}\n          >\n            <Gamepad2 size={12} strokeWidth={2.2} />\n            {t('zapret.ctxGameTest')}\n          </button>\n        </div>,\n        document.body\n      )}\n\n      <SingleStrategyTestModal\n        open={!!singleTestFile}\n        filename={singleTestFile}\n        game={singleTestGame}\n        onClose={() => { setSingleTestFile(null); setSingleTestGame(false); }}\n        onDone={(res) => { mergeSingleResult(res); loadStrategies(); }}\n      />\n    </>\n  );\n}\n"],"file":"/web/src/components/zapret/StrategiesTab.jsx"}